# Environment variables for the DynForge backend.
# On Render: Dashboard -> your service -> Environment -> add each key below.
# Never commit real values.

# --- Required ---------------------------------------------------------------
# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/dynforge?retryWrites=true&w=majority
MONGODB_DATABASE=dynforge
# Base64 of 64 random bytes (see application-local.properties.example for the PowerShell one-liner)
JWT_SECRET=
# Any long random string
WEBHOOK_SECRET=
# Public URL of the web app on Vercel (no trailing slash)
FRONTEND_BASE_URL=https://dyn-forge.vercel.app
# Web app + Android app (https://localhost), comma separated
CORS_ALLOWED_ORIGINS=https://dyn-forge.vercel.app,https://localhost

# --- Payments (PayOS merchant portal -> Kenh thanh toan) ---------------------
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# --- Email OTP (Brevo -> SMTP & API -> SMTP) ---------------------------------
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
MAIL_FROM=dynforge.edu.hcmcity@gmail.com

# --- Optional ---------------------------------------------------------------
# Google AI Studio API key; empty = built-in fallback answers
GEMINI_API_KEY=
# Google OAuth Web Client ID; empty = Google sign-in button disabled
GOOGLE_CLIENT_ID=
# Where session recordings are stored (Render free disk is wiped on every deploy)
RECORDINGS_DIR=./recordings
